# Supabase — browser realtime + auth use these.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Postgres connection for Drizzle (api/transcribe, api/embed,
# future RAG). Use Supabase's **transaction pooler** (port 6543) for
# serverless. Format: postgres://postgres.<ref>:<pwd>@aws-...pooler.supabase.com:6543/postgres
DATABASE_URL=

# LLM providers — set at least one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Groq — Whisper-large-v3 transcription via OpenAI-compatible API.
GROQ_API_KEY=

# LlamaParse (LlamaIndex Cloud) — parses uploaded course materials (PDF/DOCX/
# PPTX) into markdown for /api/materials. Get a key at https://cloud.llamaindex.ai.
# Free tier (~3,300 pages/month) covers parse-once-at-upload usage.
LLAMA_CLOUD_API_KEY=
